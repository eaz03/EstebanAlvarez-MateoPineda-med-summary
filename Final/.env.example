# Copy this file as .env (same folder) and fill in the values. .env is never committed.

# To see the runs online in W&B: https://wandb.ai/authorize
# Without it, W&B saves to wandb/ (offline) and you upload later with: uv run wandb sync wandb/offline-run-*
WANDB_API_KEY=

# Optional
# WANDB_PROJECT=medsummary
# WANDB_ENTITY=
# WANDB_MODE=          # online | offline | disabled
